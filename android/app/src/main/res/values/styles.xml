<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash screen theme.
     On Android 11 and below the windowBackground below is what the player
     sees while the engine warms up. On Android 12+ the system also draws the
     icon from windowSplashScreenAnimatedIcon on top of it. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>

    <!-- Theme applied after the splash goes away, so the Flutter surface has no
         flash of the wrong colour. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
